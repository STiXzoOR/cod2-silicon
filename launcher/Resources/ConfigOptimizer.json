    {
      "id": "competitive-frame-cap",
      "area": "movement",
      "when": "outsideCompetitiveBand",
      "setting": "com_maxfps",
      "suggest": {
        "stock": "250",
        "cod2x": "250"
      },
      "title": "Use a frame cap allowed by these rules",
      "why": "These rules allow 125–250 frames per second. A cap of 250 is within that range.",
      "notice": "Your frame cap becomes 250 fps. Your Mac’s actual frame rate may be lower.",
      "evidence": "Based on the selected rules and your saved frame cap.",
      "sources": [
        {
          "sourceURL": "https://github.com/callofduty2x/CoD2x/blob/d8c54695a5239ac99d1dfe96212b809b1a54bfee/src/mss32/competitive.cpp#L57-L61",
          "sourceDate": "2026-04-07",
          "quoteReference": "research/rulesets.json row 98; com_maxfps",
          "quote": "com_maxFps->limits.integer.min = 125; com_maxFps->limits.integer.max = 250; if (com_maxFps->value.integer < 125 || com_maxFps->value.integer > 250) { Dvar_SetInt(com_maxFps, 250); // it will also set the latched value }",
          "enforcedBy": "code",
          "archiveTimestamp": null
        },
        {
          "sourceURL": "git:048ff5e:src/PC/qcommon/cod2x_runtime.c",
          "sourceDate": "2026-10-09",
          "quoteReference": "048ff5e:src/PC/qcommon/cod2x_runtime.c Cod2x_Frame / Cod2x_Competitive",
          "quote": "{ .name = \"com_maxfps\", .min = 125, .max = 250, .value = 250 },",
          "enforcedBy": "code",
          "archiveTimestamp": null
        }
      ],
      "tuneFor": [
        "competitive",
        "balanced",
        "bestLooking"
      ]
    },
    {
