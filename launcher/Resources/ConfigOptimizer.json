    {
      "id": "conservative-texture-detail",
      "area": "visibility",
      "when": "greaterThan",
      "setting": "r_picmip",
      "suggest": {
        "stock": "2",
        "cod2x": "2"
      },
      "title": "Use more detailed textures",
      "why": "zPAM’s authors warn that the lowest texture detail can give an unfair advantage. This chooses a more detailed level and keeps your other texture choices.",
      "notice": "Textures become more detailed after reloading. Manual texture quality is enabled.",
      "evidence": "Advice from zPAM’s documented issue; league rules may differ.",
      "sources": [
        {
          "sourceURL": "https://github.com/eyza-cod2/zpam3/blob/1cfd9fb873206c35054e880ccb1d9eedaf1ec52c/README.md",
          "sourceDate": "2026-05-20",
          "quoteReference": "README known bug 5.12; research/rulesets.json row 241",
          "quote": "[5.12] r_picmip can be abused, find a way to make sure picmip 3 cant be used",
          "enforcedBy": "paper",
          "archiveTimestamp": null
        },
        {
          "sourceURL": "git:048ff5e:src/PC/gfx_d3d/r_image.c",
          "sourceDate": "2026-10-09",
          "quoteReference": "048ff5e:src/PC/gfx_d3d/r_image.c R_SetPicmip",
          "quote": "if ((r_picmip_manual)->current.enabled)",
          "enforcedBy": "code",
          "archiveTimestamp": null
        }
      ],
      "tuneFor": [
        "competitive",
        "balanced"
      ],
      "additionalChanges": [
        {
          "setting": "r_picmip_manual",
          "suggest": {
            "stock": "1",
            "cod2x": "1"
          }
        }
