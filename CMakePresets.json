{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-client",
      "displayName": "Windows MSVC client (x86, Ninja)",
      "description": "Native Windows cod2_win32.exe via cl.exe. Run from an x86 Native Tools for VS command prompt.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/msvc",
      "cacheVariables": {
        "COD2_WIN_MSVC": "ON",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    { "name": "msvc-client", "configurePreset": "msvc-client" }
  ]
}
