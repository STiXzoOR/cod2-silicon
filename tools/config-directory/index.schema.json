{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "byteCount": {
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "configURL": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          },
          "credit": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "era": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "facts": {
            "additionalProperties": false,
            "properties": {
              "frameCap": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              "resolution": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              },
              "sensitivity": {
                "maxLength": 32,
                "minLength": 1,
                "type": "string"
              }
            },
            "type": "object"
          },
          "favoriteMap": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "featured": {
            "const": true
          },
          "feel": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
            "type": "string"
          },
          "platform": {
            "enum": [
              "windows",
              "native"
            ]
          },
          "player": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "provenance": {
            "additionalProperties": false,
            "properties": {
              "attribution": {
                "enum": [
                  "self-published",
                  "listed",
                  "uploaded"
                ]
              },
              "changes": {
                "maxLength": 512,
                "minLength": 1,
                "type": "string"
              },
              "publishedBy": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string"
              },
              "retrievedAt": {
                "format": "date",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "type": "string"
              }
            },
            "required": [
              "attribution",
              "changes",
              "publishedBy",
              "retrievedAt"
            ],
            "type": "object"
          },
          "role": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "sourceURL": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          },
          "story": {
            "maxLength": 8192,
            "minLength": 1,
            "type": "string"
          },
          "styleTags": {
            "items": {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 16,
            "type": "array",
            "uniqueItems": true
          },
          "team": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "byteCount",
          "configURL",
          "credit",
          "era",
          "feel",
          "id",
          "platform",
          "player",
          "provenance",
          "sha256",
          "sourceURL",
          "story",
          "styleTags"
        ],
        "type": "object"
      },
      "maxItems": 2048,
      "type": "array"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1
    }
  },
  "required": [
    "schemaVersion",
    "revision",
    "entries"
  ],
  "title": "Signed directory index v1",
  "type": "object"
}
