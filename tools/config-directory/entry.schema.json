{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credit": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "era": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "favoriteMap": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "feel": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "permission": {
      "additionalProperties": false,
      "properties": {
        "evidenceURL": {
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "grantedAt": {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        },
        "grantedBy": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "const": "public-redistribution"
        }
      },
      "required": [
        "grantedBy",
        "grantedAt",
        "evidenceURL",
        "scope"
      ],
      "type": "object"
    },
    "platform": {
      "enum": [
        "windows",
        "native"
      ]
    },
    "player": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "role": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "sourceURL": {
      "format": "uri",
      "pattern": "^https://",
      "type": "string"
    },
    "story": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "styleTags": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "team": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "credit",
    "era",
    "feel",
    "permission",
    "platform",
    "player",
    "role",
    "sourceURL",
    "story",
    "styleTags"
  ],
  "title": "Permissioned source metadata v1",
  "type": "object"
}
