{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "credit": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "era": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "facts": {
      "additionalProperties": false,
      "properties": {
        "frameCap": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "resolution": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "sensitivity": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "favoriteMap": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "featured": {
      "const": true
    },
    "feel": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "platform": {
      "enum": [
        "windows",
        "native"
      ]
    },
    "player": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "enum": [
            "self-published",
            "listed",
            "uploaded"
          ]
        },
        "changes": {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        "publishedBy": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "retrievedAt": {
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "type": "string"
        }
      },
      "required": [
        "attribution",
        "changes",
        "publishedBy",
        "retrievedAt"
      ],
      "type": "object"
    },
    "role": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    },
    "sourceURL": {
      "format": "uri",
      "pattern": "^https://",
      "type": "string"
    },
    "story": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "styleTags": {
      "items": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "team": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "credit",
    "era",
    "feel",
    "platform",
    "player",
    "provenance",
    "sourceURL",
    "story",
    "styleTags"
  ],
  "title": "Permissioned source metadata v1",
  "type": "object"
}
